  "content": {
    "title": "MoleculeNet 的总体设计",
    "summary": "MoleculeNet 以统一接口，把数据集、特征化方法、划分方式与学习模型组合为可复现的分子机器学习基准框架。",
    "hub_text": "MoleculeNet：统一基准枢纽；数据集、评估指标、特征化与学习模型四条主线均可替换与重新组合。",
    "stat_datasets": "17 个数据集",
    "stat_compounds": "70 万+ 化合物",
    "stat_tasks": "800+ 任务",
    "pillars_heading": "任务分类与开源集成",
    "key_points": [
      "任务分为四类：量子力学、物理化学、生物物理、生理效应",
      "统一集成到开源 DeepChem，提供数据加载、特征化、划分与模型接口",
      "强调可替换的 featurization、split 与 learning model 组合",
      "本次复现仅覆盖 ESOL、FreeSolv、Lipophilicity 三个物理化学数据集"
    ],
    "scope_note": "复现范围声明：仅使用 ESOL、FreeSolv、Lipophilicity 三个物理化学数据集，不覆盖其余任务类别。"
  },
